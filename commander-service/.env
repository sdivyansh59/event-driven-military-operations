# Commander Service .env
ENVIRONMENT=development
LOG_LEVEL=info
LOG_DIR=logs
PORT=8081

# postgres
POSTGRES_DB_URL=postgres://postgres:postgres@localhost:5432/commanders_camp_db?sslmode=disable

# RabbitMQ
RABBITMQ_URL=amqp://admin:password@localhost:5672/
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# Shared secret for auth service (keep the same across services)
SECRET_KEY=a3f5c8d9e2b47c1f9d0a5b2c3e4f6789